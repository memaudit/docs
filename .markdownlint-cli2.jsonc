{
	"config": {
		"MD013": false, // line length - prose doesn't need wrapping enforcement
		"MD033": false, // inline HTML - the SPDX header comment block needs this
		"MD060": false // table column style - reference tables use plain, unpadded pipes; not worth reformatting for a cosmetic-only rule
	},
	"ignores": [
		"node_modules/**",
		// scaffold-generated Astro/Starlight agent notes, not authored docs content
		"AGENTS.md",
		"CLAUDE.md"
	]
}
